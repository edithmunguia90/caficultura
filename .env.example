# ============================================================
# .env.example
# Plantilla de configuracion de variables de entorno
# Copiar este archivo como .env y rellenar con sus credenciales
# ============================================================

# Clave de API de Google Gemini (Opcional, para Gemini Vision AI y Oraculo Cloud)
# Obtener gratuitamente en: https://aistudio.google.com/
GEMINI_API_KEY=su_clave_api_gemini_aqui

# Host del servicio local de Ollama (por defecto: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

